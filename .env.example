POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=n8n

N8N_ENCRYPTION_KEY=super-secret-key
N8N_USER_MANAGEMENT_JWT_SECRET=even-more-secret
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# For Mac users running OLLAMA locally
# See https://github.com/n8n-io/self-hosted-ai-starter-kit?tab=readme-ov-file#for-mac--apple-silicon-users
# OLLAMA_HOST=host.docker.internal:11434

# Public domain (fronted by the caddy reverse proxy in docker-compose.yml)
WEBHOOK_URL=https://n8n.aiworks.az/
N8N_HOST=n8n.aiworks.az
N8N_PROTOCOL=https

# Optional: if set, the deploy script auto-registers the Telegram webhook
# against the current Cloudflare Quick Tunnel URL after every deploy.
# TELEGRAM_BOT_TOKEN=123456:your-bot-token
# TELEGRAM_WEBHOOK_PATH=webhook/telegram-voice-webhook/webhook
